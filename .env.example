# Local studio defaults. Local ChatGPT sign-in does not require a provider API key.
# The hosted API-funded runtime is separate; see docs/DEPLOYMENT.md before enabling.
PORT=3001
LANDWISE_APP_ORIGIN=http://127.0.0.1:5174

# By default, protected ChatGPT connection records stay in ~/.config/landwise.
# LANDWISE_AUTH_DIR=/absolute/private/path/landwise

# Optional local cloud library. Existing local folders are not uploaded automatically.
LANDWISE_APPLICATION_STORAGE=local
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# SUPABASE_PUBLISHABLE_KEY is browser-visible; never put a secret/service-role key there.

# Safe defaults for a new hosted installation. The existing live site has AI enabled.
# Existing migrations are applied; follow docs/DEPLOYMENT.md for fresh activation.
# Current URL: https://landwise-nu.vercel.app
# The hosted entrypoint always uses Supabase and never reads local ChatGPT files.
LANDWISE_HOSTED_AI_ENABLED=false
# Public email delivery is not verified. Configure/test SMTP before enabling signup.
# Google OAuth would also require implementing its sign-in UI; it is not enabled here.
LANDWISE_ACCOUNT_SIGN_IN_ENABLED=false
# LANDWISE_APP_ORIGIN=https://landwise-nu.vercel.app
# SUPABASE_URL=https://audfewrmqgsefeutappd.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# SERVER ONLY. Store in ignored local files or deployment secrets, never VITE_* or Git.
# SUPABASE_SERVICE_ROLE_KEY=sb_secret_replace_me
# Deployment compatibility only: exact-case Supabase_Key is a server-only fallback
# when SUPABASE_SERVICE_ROLE_KEY is absent. The canonical setting always wins.
# Both names require a Supabase secret/service-role key, never a publishable key.
# Supabase_Key=sb_secret_replace_me
# OPENAI_API_KEY=replace_with_project_api_key
# LANDWISE_SESSION_SECRET=replace_with_random_secret_at_least_32_bytes
# Keep the session secret stable across replicas/deployments; rotating it resets guest identity hashes.
# No automatic top-ups/reloads. Verify a real US$5 provider spending stop before activation.
# The application reserves US$0.06/job within its separate US$4 monthly budget.
# These are application constants, not configurable env overrides; see docs/DEPLOYMENT.md.
