# ── Required ──────────────────────────────────────────────────────────────────
# Anthropic API key — used for all LLM calls (Haiku + Sonnet)
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# ── Optional: Embedding-based RAG ─────────────────────────────────────────────
# OpenAI API key — enables semantic (embedding) retrieval for RAG.
# Without this key the system silently falls back to TF-IDF retrieval,
# which works well but has weaker semantic generalisation (e.g. "React"
# won't match "frontend development" unless those words overlap).
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Embedding model (optional — defaults to text-embedding-3-small)
# Other options: text-embedding-3-large (higher quality, ~5× cost)
#                text-embedding-ada-002 (legacy, lower quality)
EMBEDDING_MODEL=text-embedding-3-small
