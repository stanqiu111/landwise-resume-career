# Optional local configuration. No provider API keys are required.
PORT=3001
LANDWISE_APP_ORIGIN=http://127.0.0.1:5174

# By default, protected ChatGPT connection records stay in ~/.config/landwise.
# LANDWISE_AUTH_DIR=/absolute/private/path/landwise

# Optional private application library; see docs/SUPABASE.md before enabling.
LANDWISE_APPLICATION_STORAGE=local
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Never use a secret/service-role key here. This key is returned to the browser.
