{
  "name": "landwise",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "description": "AI resume tailoring and job-search tools for students, with fit reports and career events in Canada and the United States.",
  "keywords": ["resume", "job", "job-search", "resume-tailoring", "career", "students", "career-events"],
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <25"
  },
  "scripts": {
    "dev": "concurrently --kill-others-on-fail \"node server.js\" \"vite\"",
    "server": "node server.js",
    "build": "vite build",
    "build:hosted": "node scripts/build-hosted.mjs",
    "verify:hosted": "npm run security:check && npm run lint && npm test && npm run build:hosted",
    "security:setup": "node scripts/secret-scan.mjs --setup",
    "security:check": "node scripts/secret-scan.mjs",
    "security:history": "node scripts/secret-scan.mjs --history",
    "check": "npm run verify:hosted && npm run build",
    "check:live": "node scripts/check-live.mjs",
    "clean": "node scripts/clean.mjs",
    "lint": "eslint .",
    "test": "node --test",
    "preview": "vite preview",
    "preview:hosted": "vite preview --outDir dist-hosted"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "concurrently": "^10.0.3",
    "docx": "^9.7.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jose": "^6.2.12",
    "jspdf": "^4.2.1",
    "multer": "^2.1.1",
    "openai": "^6.42.0",
    "pdf-parse": "^2.4.5",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "vite": "^8.1.6"
  }
}
